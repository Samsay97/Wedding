+
+/* ==========================================================
+   AUDIO TOGGLE
+   стеклянная кнопка: овал -> круг при прокрутке
+========================================================== */
+
+.audio-toggle {
+  width: 164px;
+  min-width: 52px;
+  justify-content: flex-start;
+  overflow: hidden;
+  white-space: nowrap;
+  transition:
+    width .44s cubic-bezier(.22, 1, .36, 1),
+    padding .44s cubic-bezier(.22, 1, .36, 1),
+    gap .34s ease,
+    transform var(--transition),
+    opacity var(--transition),
+    background var(--transition);
+}
+
+.audio-toggle-icon {
+  flex: 0 0 28px;
+}
+
+#audioToggleLabel {
+  display: block;
+  max-width: 104px;
+  overflow: hidden;
+  opacity: 1;
+  transform: translateX(0);
+  transition:
+    max-width .38s ease,
+    opacity .22s ease,
+    transform .38s ease;
+}
+
+.audio-toggle.is-compact {
+  width: 52px;
+  padding-inline: 11px;
+  gap: 0;
+}
+
+.audio-toggle.is-compact #audioToggleLabel {
+  max-width: 0;
+  opacity: 0;
+  transform: translateX(8px);
+}
+
+/* ==========================================================
+   GALLERY
+   конечная галерея: один свайп = ровно одно фото
+========================================================== */
+
+.gallery-track {
+  overflow-x: hidden;
+  padding-inline: 14%;
+  scroll-snap-type: none;
+  touch-action: pan-y;
+  overscroll-behavior-x: contain;
+  cursor: grab;
+}
+
+.gallery-track.is-dragging {
+  cursor: grabbing;
+}
+
+.gallery-item {
+  scroll-snap-align: none;
+  user-select: none;
+  -webkit-user-drag: none;
+}
+
+.gallery-item img {
+  pointer-events: none;
+}
+
+.gallery-nav:disabled {
+  opacity: .3;
+  cursor: default;
+  transform: none;
+}
+
+@media (max-width: 680px) {
+  .gallery-track {
+    padding-inline: 6%;
+  }
+
+  .hero-layout .hero-names {
+    margin-top: 8px;
+  }
+}

